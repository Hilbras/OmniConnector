{
  "name": "@hilbras/omniconnector",
  "version": "0.1.0",
  "description": "TypeScript client for the OmniConnector Kernel API: run integration operations without handling credentials",
  "keywords": ["omniconnector", "hilbras", "integrations", "connections", "sdk", "client"],
  "license": "MIT",
  "author": "Hassan El-Deghidy",
  "homepage": "https://github.com/Hilbras/OmniConnector/tree/main/packages/client-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hilbras/OmniConnector.git",
    "directory": "packages/client-sdk"
  },
  "bugs": "https://github.com/Hilbras/OmniConnector/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
